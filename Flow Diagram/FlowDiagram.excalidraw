      "seed": 1869687233,
      "version": 881,
      "versionNonce": 369042145,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789400040931,
      "created": 1789397572014,
      "link": null,
      "locked": false,
      "text": "Table: customers\n\nDescription:\nContains customers registered in the system.\n\nColumns:\n- id: unique customer identifier\n- name: customer's full name\n- email: customer's email address\n- created_at: date the customer registered\n\nRelationships:\n- customers.id ← orders.customer_id\n\nBusiness meaning:\nRepresents a customer/account.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "4kgU8rfnOA40V5e5emN-f",
      "originalText": "Table: customers\n\nDescription:\nContains customers registered in the system.\n\nColumns:\n- id: unique customer identifier\n- name: customer's full name\n- email: customer's email address\n- created_at: date the customer registered\n\nRelationships:\n- customers.id ← orders.customer_id\n\nBusiness meaning:\nRepresents a customer/account.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
