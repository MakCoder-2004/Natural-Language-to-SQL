    {
      "id": "zu9ZDgc1-2GGPg0Bf_Xs4",
      "type": "text",
      "x": -612.3356779421138,
      "y": 363.3480633365174,
      "width": 617.81982421875,
      "height": 560,
      "angle": 0,
      "strokeColor": "#1e1e1e",
