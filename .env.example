# Backend-only PostgreSQL connections. The source database is external to Compose.
SOURCE_DATABASE_URL=postgresql+psycopg://<user>:<password>@<external-host>:5432/<source-database>
INDEX_DB_NAME=schema_index
INDEX_DB_USER=index_user
INDEX_DB_PASSWORD=<index-database-password>
INDEX_DATABASE_URL=postgresql+psycopg://<user>:<password>@index-db:5432/<index-database>

# Backend-only OpenRouter configuration.
OPENROUTER_API_KEY=<backend-only-secret>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
QUESTION_MODEL=nex-agi/nex-n2.5-pro:free
SQL_MODEL=nex-agi/nex-n2.5-pro:free
SQL_CORRECTION_MODEL=nex-agi/nex-n2.5-pro:free
ANSWER_MODEL=nex-agi/nex-n2.5-pro:free
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# Approved source schemas and deterministic query safeguards.
SOURCE_SCHEMA_SCOPE=<schema-name>
SEMANTIC_METADATA_PATH=../schema_index/metadata
DATABASE_CONNECT_TIMEOUT_SECONDS=10
SOURCE_POOL_SIZE=5
SOURCE_MAX_OVERFLOW=10
SOURCE_POOL_TIMEOUT_SECONDS=10
SOURCE_POOL_RECYCLE_SECONDS=1800
INDEX_POOL_SIZE=5
INDEX_MAX_OVERFLOW=10
INDEX_POOL_TIMEOUT_SECONDS=10
INDEX_POOL_RECYCLE_SECONDS=1800
MAX_CORRECTION_RETRIES=2
MAX_REGENERATION_COUNT=3
MAX_RETURNED_ROWS=1000
MAX_RESULT_BYTES=5000000
QUERY_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=64
EMBEDDING_REQUEST_TIMEOUT_SECONDS=60
MODEL_REQUEST_TIMEOUT_SECONDS=30

# Backend-controlled hybrid schema retrieval bounds.
RETRIEVAL_VECTOR_CANDIDATE_LIMIT=16
RETRIEVAL_KEYWORD_CANDIDATE_LIMIT=16
RETRIEVAL_MAX_SELECTED_TABLES=8
RETRIEVAL_MAX_COLUMNS_PER_TABLE=12
RETRIEVAL_MAX_RELATIONSHIPS=8
RETRIEVAL_MAX_RELATIONSHIP_HOPS=1
RETRIEVAL_MAX_EXPANDED_TABLES=4
RETRIEVAL_MAX_CONTEXT_DOCUMENTS=64
RETRIEVAL_MAX_CONTEXT_CHARACTERS=12000
RETRIEVAL_MIN_VECTOR_SIMILARITY=0.20
RETRIEVAL_VECTOR_WEIGHT=0.60
RETRIEVAL_KEYWORD_WEIGHT=0.40
RETRIEVAL_RRF_CONSTANT=60
STRICT_SEMANTIC_METADATA=false
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:5173
