# Backend-only PostgreSQL connections. The source database is external to Compose.
SOURCE_DATABASE_URL=postgresql+psycopg://<user>:<password>@<external-host>:5432/<source-database>
INDEX_DB_NAME=schema_index
INDEX_DB_USER=index_user
INDEX_DB_PASSWORD=<index-database-password>
INDEX_DATABASE_URL=postgresql+psycopg://<user>:<password>@index-db:5432/<index-database>

# Backend-only OpenRouter configuration.
OPENROUTER_API_KEY=<backend-only-secret>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
QUESTION_MODEL=<question-model-id>
SQL_MODEL=<sql-model-id>
SQL_CORRECTION_MODEL=<sql-correction-model-id>
ANSWER_MODEL=<answer-model-id>
EMBEDDING_MODEL=<embedding-model-id>

# Approved source schemas and deterministic query safeguards.
SOURCE_SCHEMA_SCOPE=<schema-name>
DATABASE_CONNECT_TIMEOUT_SECONDS=10
SOURCE_POOL_SIZE=5
SOURCE_MAX_OVERFLOW=10
SOURCE_POOL_TIMEOUT_SECONDS=10
SOURCE_POOL_RECYCLE_SECONDS=1800
INDEX_POOL_SIZE=5
INDEX_MAX_OVERFLOW=10
INDEX_POOL_TIMEOUT_SECONDS=10
INDEX_POOL_RECYCLE_SECONDS=1800
MAX_CORRECTION_RETRIES=2
MAX_RETURNED_ROWS=1000
MAX_RESULT_BYTES=5000000
QUERY_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:5173
